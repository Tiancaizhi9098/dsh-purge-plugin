{
  "name": "dsh-purge-plugin",
  "version": "0.2.2",
  "description": "Eight backed-up DSH runtime patches and a global AGENTS.md editor",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "test",
    "README.md",
    "LICENSE",
    ".github/workflows/ci.yml",
    "cordis.patch.yml",
    "tsconfig.json",
    "VALIDATION.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tiancaizhi9098/dsh-purge-plugin.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.2",
    "@electron/asar": "^4.3.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0",
    "yaml": "^2.8.1"
  }
}
